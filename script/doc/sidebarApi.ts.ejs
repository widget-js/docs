import type { DefaultTheme } from 'vitepress'

export function sidebarApi():DefaultTheme.SidebarItem[] {
  return [<% for(var i=0; i<apiList.length; i++) {%>
    { text: '<%= apiList[i] %>', link: '/api/<%= apiList[i] %>' },<% } %>
  ]
}

export function sidebarApiEn():DefaultTheme.SidebarItem[] {
  return [<% for(var i=0; i<apiList.length; i++) {%>
    { text: '<%= apiList[i] %>', link: '/en/api/<%= apiList[i] %>' },<% } %>
  ]
}
